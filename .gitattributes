# Normalise line endings. Without this the repository stores whatever the
# committing machine used, and everything committed from Windows arrives on
# Linux and macOS with CRLF and a ^M on every line of every diff.
* text=auto eol=lf

# Binary assets: never touch these, and do not try to diff them as text.
*.png binary
*.jpg binary
*.jpeg binary
*.pt  binary
*.pth binary

# Notebooks are JSON. Treat them as text so they normalise, but suppress diffs:
# a single re-execution rewrites every output blob and drowns the real change.
*.ipynb text -diff
